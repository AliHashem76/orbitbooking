# Orbit Booking — Environment Variables
# Copy to `.env.local` and fill in values from your Supabase project settings.

# Public (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only — never expose to the client
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Session signing secret (min 32 characters)
AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# WhatsApp inquiry number (digits only, country code included)
NEXT_PUBLIC_WHATSAPP_NUMBER=96170985130

# App URL (used in emails / absolute links if needed)
NEXT_PUBLIC_APP_URL=http://localhost:3000
